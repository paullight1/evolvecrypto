# --- Running the binary directly (in-memory mode unless DATABASE_URL is set) ---
DATABASE_URL=postgres://exchange:exchange@localhost:5432/exchange
EXCHANGE_DATA_DIR=./data
RUST_LOG=info,exchange=debug

# --- Docker Compose (docker-compose.yml) ---
# Copy this file to .env and set the secrets below before running `docker compose up`.
# POSTGRES_PASSWORD and GRAFANA_ADMIN_PASSWORD have no default — compose fails if unset.
POSTGRES_USER=exchange
POSTGRES_PASSWORD=
POSTGRES_DB=exchange
GRAFANA_ADMIN_PASSWORD=
